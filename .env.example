# ==============================================
# Variator2026 — Environment Variables Example
# Скопируйте в .env и заполните своими значениями
# cp .env.example .env
# ==============================================

# ----------------------------------------------
# Общие настройки
# ----------------------------------------------
LOG_LEVEL=debug           # debug | info | warn | error
PORT=9090
CONFIG_PATH=./configs

# ----------------------------------------------
# PostgreSQL
# ----------------------------------------------
DB_HOST=localhost         # В Docker: db
DB_PORT=5432
DB_NAME=variator
DB_USER=postgres
DB_PASS=your_db_password  # ⚠️ Замените в production

# ----------------------------------------------
# Redis
# ----------------------------------------------
REDIS_HOST=localhost      # В Docker: redis
REDIS_PORT=6379
REDIS_PASSWORD=           # Пусто если без пароля
# REDIS_ADDR=redis:6379   # Альтернативно для Docker

# ----------------------------------------------
# JWT
# ----------------------------------------------
# ⚠️ ОБЯЗАТЕЛЬНО смените на случайную строку в production!
# Генерация: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-secret-in-production

# ----------------------------------------------
# Goose (миграции — используется только локально)
# В Docker миграции накатываются автоматически через docker-entrypoint.sh
# ----------------------------------------------
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:your_db_password@localhost:5432/variator?sslmode=disable
GOOSE_MIGRATION_DIR=./migrations
